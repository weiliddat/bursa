{
	"name": "bursa",
	"version": "0.1.0",
	"description": "Minimalistic plain-text personal finance tool",
	"type": "module",
	"scripts": {
		"start": "vite",
		"dev": "vite",
		"build": "tsc && vite build",
		"preview": "vite preview",
		"test": "vitest run --coverage && tsc --noEmit",
		"test:watch": "vitest watch",
		"test:coverage": "vitest run --coverage",
		"bench": "vitest bench --run",
		"check": "tsc --noEmit",
		"lint": "biome check .",
		"lint:fix": "biome check --write ."
	},
	"keywords": [
		"finance",
		"plaintext",
		"accounting",
		"budgeting"
	],
	"author": "",
	"license": "MIT",
	"devDependencies": {
		"@biomejs/biome": "^2.3.11",
		"@solidjs/testing-library": "^0.8.10",
		"@testing-library/jest-dom": "^6.9.1",
		"@types/node": "^25.0.3",
		"@vitest/coverage-v8": "^4.0.16",
		"dedent": "^1.7.1",
		"jsdom": "^27.4.0",
		"solid-devtools": "^0.34.5",
		"typescript": "^5.9.3",
		"vite": "^7.3.0",
		"vite-plugin-solid": "^2.11.10",
		"vitest": "^4.0.16"
	},
	"dependencies": {
		"solid-js": "^1.9.11"
	}
}
